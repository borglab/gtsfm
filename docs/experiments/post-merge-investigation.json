{
  "purpose": "Investigate saved RootSIFT benchmark post-merge accuracy losses and Skydio-32 legacy RootSIFT serialization failure, separately from PR #1173.",
  "diagnostic_code_commit": "adc79354",
  "original_benchmark_code_commit": "8f21351c",
  "methodology": {
    "input": "Reload the identical saved rootsift/results/ba_output COLMAP-format scene separately for every BA variant. Do not rerun features, matching, triangulation, or camera registration.",
    "optimizer": "BundleAdjustmentOptions.to_optimizer().run_simple_ba(scene)",
    "metric": "Relative-pose AUC percentages over all reference-image pairs, max(rotation error, translation direction error); missing cameras count as failures.",
    "door_reference": "tests/data/set1_lund_door/data.mat via OlssonLoader; 12 images, 66 pairs",
    "astro_reference": "benchmarks/2011205_rc3 reference model; 65 images, 2080 pairs",
    "script_on_experiment_machine": "/tmp/replay_merge_ba.py",
    "evaluator": "scripts/evaluate_sift_comparison.py on codex/rootsift-five-benchmarks at d72f6e3b",
    "command": "PYTHONPATH=. OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 /home/dellaert/.local/share/uv/tools/gtsfm/bin/python /tmp/replay_merge_ba.py --scene {door,astro}",
    "default_post_ba": {
      "shared_calib": false,
      "use_calibration_prior": false,
      "robust_ba_mode": "GMC",
      "measurement_noise_sigma": 2.0,
      "min_track_length": 2
    },
    "shared_and_prior": "Same default, shared_calib=True and use_calibration_prior=True",
    "shared_only": "Same default, shared_calib=True",
    "prior_only": "Same default, use_calibration_prior=True",
    "leaf_like": "Same default, shared_calib=True, use_calibration_prior=True, robust_ba_mode=HUBER, measurement_noise_sigma=1.0, min_track_length=3"
  },
  "findings": [
    {
      "cause": "Leaf calibration policy is not propagated into post-merge/retriangulation BA.",
      "code": [
        "gtsfm/cluster_merging.py:MergingOptions.ba_options",
        "gtsfm/scene_optimizer.py:_run_post_merge_retriangulation",
        "gtsfm/bundle/bundle_adjustment.py:BundleAdjustmentOptions"
      ],
      "evidence": "These runs use SinglePartitioner: no child alignment is performed. The later BA still runs, replacing shared calibration plus priors with independent calibration and no calibration priors. Door shared-only vs prior-only ablations isolate the importance of sharing.",
      "original_full_pipeline_auc5": {
        "door": {
          "first_ba": 96.9813,
          "after_retriangulation": 86.13
        },
        "astro": {
          "first_ba": 98.9502,
          "after_retriangulation": 69.889
        }
      },
      "proposed_follow_up": "Carry the intended calibration-sharing and prior policy into classical merge/retriangulation BA, while preserving explicit options for heterogeneous cameras and feedforward pipelines. Do not change shared_calib globally."
    },
    {
      "cause": "Axis alignment turns a finite singleton cloud into NaN geometry and GTSAM deserialization raises input stream error.",
      "code": [
        "gtsfm/utils/ellipsoid.py:get_ortho_axis_alignment_transform",
        "gtsfm/utils/ellipsoid.py:remove_outlier_points",
        "gtsfm/cluster_optimizer/cluster_mvo.py:align_estimated_gtsfm_data"
      ],
      "evidence": "A strict 95th-percentile cutoff excludes every point of a singleton or equal-radius cloud. Mean of the empty inlier cloud becomes NaN without raising; the transform contaminates BA input, BA output, and GT. A finite three-camera one-point scene reproduces the exact GTSAM pickle input stream error after applying that transform.",
      "fix_on_this_branch": "Return identity for empty scenes, center the original finite cloud without estimating rotation when fewer than three filtered points remain, and reject nonfinite input points.",
      "regression_tests": "All four new finite-geometry/pickle regressions fail before the fix and pass afterward. Existing alignment and post-merge retriangulation tests also pass: 16 total. Exact repository CI flake8 passes."
    }
  ],
  "limitations": [
    "BA-only ablations are not reruns of full post-merge retriangulation and filtering. Their AUC values must not replace the dashboard full-pipeline results.",
    "Calibration priors in these replays are centered on saved optimized intrinsics, rather than original image metadata intrinsics.",
    "The saved legacy Skydio-32 leaf reconstruction already collapses from 896 tracks / 30 cameras to one track / three cameras before axis alignment. The serialization fix does not explain or repair that earlier collapse.",
    "NaNs in exported BA input do not prove translation averaging was nonfinite: visualization applies the bad output-derived axis transform to input too.",
    "No real multi-cluster alignment failure was reproduced by these single-cluster benchmarks.",
    "Diagnostic results are single-run measurements on saved local scenes; COLMAP-format reference reading introduces no production COLMAP feature extractor dependency."
  ],
